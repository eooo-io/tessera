{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessera.dev/schema/conversation-normal-form.v1.json",
  "title": "Tessera branch-preserving conversation normal form v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "conversations"],
  "properties": {
    "schema_version": { "const": "tessera.conversation.v1" },
    "source": { "$ref": "#/$defs/source" },
    "conversations": { "type": "array", "items": { "$ref": "#/$defs/conversation" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "extensions": { "type": "object", "additionalProperties": true },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["product", "source_hash", "parser", "normalizer"],
      "properties": {
        "product": { "enum": ["claude_code", "claude", "chatgpt"] },
        "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "parser": { "$ref": "#/$defs/component" },
        "normalizer": { "$ref": "#/$defs/component" },
        "export_id": { "type": "string" }
      }
    },
    "conversation": {
      "type": "object", "additionalProperties": false,
      "required": ["conversation_id", "sensitivity", "source_records", "nodes", "selected_path"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }, "project": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
        "source_records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRecord" } },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "selected_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "sourceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "record_index"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "record_index": { "type": "integer", "minimum": 0 },
        "source_id": { "type": "string" },
        "byte_start": { "type": "integer", "minimum": 0 }, "byte_end": { "type": "integer", "minimum": 0 },
        "line_start": { "type": "integer", "minimum": 1 }, "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "role", "state", "source_record_ids", "content_parts"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "parent_node_id": { "type": "string" },
        "role": { "enum": ["user", "assistant", "system", "tool", "unknown"] },
        "state": { "enum": ["visible", "hidden", "deleted", "partial", "compacted", "malformed", "unsupported"] },
        "timestamp": { "type": "string", "format": "date-time" }, "model": { "type": "string" },
        "source_record_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "content_parts": { "type": "array", "items": { "$ref": "#/$defs/contentPart" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "contentPart": {
      "type": "object", "additionalProperties": false,
      "required": ["part_id", "kind"],
      "properties": {
        "part_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["text", "code", "tool_use", "tool_result", "attachment", "file", "image", "compaction", "error", "unsupported"] },
        "text": { "type": "string" }, "language": { "type": "string" },
        "tool_name": { "type": "string" }, "tool_use_id": { "type": "string" },
        "data": true,
        "attachment": { "$ref": "#/$defs/attachment" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["attachment_id", "preservation"],
      "properties": {
        "attachment_id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string" }, "media_type": { "type": "string" },
        "preservation": { "enum": ["preserved", "missing", "external_unfetched", "unsupported"] },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
