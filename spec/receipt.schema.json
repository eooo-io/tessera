{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessera.ai/schemas/receipt.json",
  "title": "Tessera Receipt",
  "description": "Versioned, hash-chained record of an exact Tessera disclosure session. Receipts without schema_version are legacy v1 records.",
  "type": "object",
  "required": ["receipt_id", "session_id", "agent", "lens", "purpose", "started_at", "queries", "summary", "seq"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "receipt_id": { "type": "string", "pattern": "^rcpt_" },
    "session_id": { "type": "string", "pattern": "^sess_" },
    "pairing_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "prev_receipt_hash": { "$ref": "#/$defs/nullableHash" },
    "self_hash": { "$ref": "#/$defs/nullableHash" },
    "agent": {
      "type": "object",
      "required": ["agent_id", "name"],
      "properties": {
        "agent_id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "lens": {
      "type": "object",
      "required": ["lens_id", "name"],
      "properties": {
        "lens_id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "effective_lens": {
      "type": "object",
      "required": ["policy", "policy_hash"],
      "properties": {
        "policy": { "type": "object" },
        "policy_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "purpose": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "queries": {
      "type": "array",
      "items": { "$ref": "#/$defs/legacyQuery" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "rate_limit_events": { "type": "array" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "description": "Legacy v1 receipt compatibility",
          "not": { "required": ["schema_version"] }
        },
        {
          "description": "Receipt schema v2",
          "required": ["schema_version", "effective_lens"],
          "properties": {
            "schema_version": { "const": 2 },
            "queries": {
              "type": "array",
              "items": { "$ref": "#/$defs/v2Query" }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableHash": {
      "anyOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    },
    "byteRange": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "legacyAccess": {
      "type": "object",
      "required": ["artifact_id", "artifact_title", "disclosure_mode", "bytes_disclosed"],
      "properties": {
        "artifact_id": { "type": "string" },
        "artifact_title": { "type": "string" },
        "disclosure_mode": { "enum": ["summary", "excerpt", "full"] },
        "bytes_disclosed": { "type": "integer", "minimum": 0 }
      }
    },
    "v2Access": {
      "allOf": [
        { "$ref": "#/$defs/legacyAccess" },
        {
          "type": "object",
          "required": [
            "access_kind",
            "artifact_version_id",
            "evidence_blob_hash",
            "disclosed_range",
            "disclosed_content_hash",
            "returned_bytes",
            "requested_disclosure_mode",
            "applied_disclosure_mode",
            "metadata_allowed",
            "full_disclosure_allowed",
            "provenance"
          ],
          "properties": {
            "access_kind": { "enum": ["semantic_query", "direct_item"] },
            "artifact_version_id": { "type": "string", "pattern": "^artv_" },
            "derived_text_id": { "type": "string", "pattern": "^dtx_" },
            "chunk_id": { "type": "string", "pattern": "^chunk_" },
            "summary_id": { "type": "string", "pattern": "^sum_" },
            "evidence_blob_hash": { "$ref": "#/$defs/hash" },
            "disclosed_range": { "$ref": "#/$defs/byteRange" },
            "disclosed_content_hash": { "$ref": "#/$defs/hash" },
            "returned_bytes": { "type": "integer", "minimum": 0 },
            "requested_disclosure_mode": { "enum": ["summary", "excerpt", "full"] },
            "applied_disclosure_mode": { "enum": ["summary", "excerpt", "full"] },
            "metadata_allowed": { "type": "boolean" },
            "full_disclosure_allowed": { "type": "boolean" },
            "provenance": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "tool", "locality"],
                "properties": {
                  "id": { "type": "string", "pattern": "^prov_" },
                  "tool": { "type": "string" },
                  "tool_version": { "type": ["string", "null"] },
                  "locality": { "enum": ["local", "cloud"] }
                }
              }
            },
            "retrieval": {
              "type": "object",
              "required": ["rank", "score", "model"],
              "properties": {
                "rank": { "type": "integer", "minimum": 1 },
                "score": { "type": "number" },
                "model": {
                  "type": "object",
                  "required": ["name", "version", "dimensions"],
                  "properties": {
                    "name": { "type": "string" },
                    "version": { "type": "string" },
                    "dimensions": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "access_kind": { "const": "semantic_query" } } },
              "then": { "required": ["derived_text_id", "chunk_id", "retrieval"] }
            },
            {
              "if": { "properties": { "applied_disclosure_mode": { "const": "summary" } } },
              "then": { "required": ["summary_id"] },
              "else": { "required": ["derived_text_id"] }
            }
          ]
        }
      ]
    },
    "legacyQuery": {
      "type": "object",
      "required": ["query_id", "timestamp", "query_text", "artifacts_accessed"],
      "properties": {
        "query_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "query_text": { "type": "string" },
        "artifacts_accessed": {
          "type": "array",
          "items": { "$ref": "#/$defs/legacyAccess" }
        }
      }
    },
    "v2Query": {
      "type": "object",
      "required": ["query_id", "timestamp", "query_text", "artifacts_accessed"],
      "properties": {
        "query_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "query_text": { "type": "string" },
        "artifacts_accessed": {
          "type": "array",
          "items": { "$ref": "#/$defs/v2Access" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_queries", "unique_artifacts_accessed", "total_bytes_disclosed", "disclosure_modes_used"],
      "properties": {
        "total_queries": { "type": "integer", "minimum": 0 },
        "unique_artifacts_accessed": { "type": "integer", "minimum": 0 },
        "total_bytes_disclosed": { "type": "integer", "minimum": 0 },
        "disclosure_modes_used": {
          "type": "array",
          "items": { "enum": ["summary", "excerpt", "full"] }
        }
      }
    }
  }
}
